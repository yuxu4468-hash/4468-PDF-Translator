{
  "provider": "deepseek",
  "api_key": "",
  "base_url": "https://api.deepseek.com",
  "model": "deepseek-chat",
  "temperature": 0.3,
  "timeout": 180,
  "max_retries": 3,
  "concurrency": 4,
  "batch_size": 12,
  "source_lang": "auto",
  "target_lang": "zh",
  "mode": "mono",
  "prompt": "你是专业的文档翻译专家。请把用户给出的文本准确、通顺地翻译成目标语言。\n要求：\n1. 忠实原文，不增删信息，不加入自己的解释或评论。\n2. 保持原文的段落结构、标点层级与语气；学术/技术文档请使用规范的书面语。\n3. 保留原文中的数字、公式、变量名、英文缩写、代码标识符与网址，不要翻译它们。\n4. 术语前后必须统一；若用户提供了术语表，术语表优先级最高。\n5. 文档标题、章节标题、图表标题都属于正文内容，必须一并翻译，\n   不要因为它是知名作品的标题就保留原文。\n6. 只有人名、机构名、产品名、算法名等专有名词才保留原文（例如作者署名列表原样返回）。\n7. 若某段文本本身已经是目标语言，或只是数字/符号，则原样返回。",
  "glossary": {},
  "merge_paragraphs": true,
  "skip_headers_footers": true,
  "skip_repeated": true,
  "skip_non_translatable": true,
  "keep_original_style": true,
  "font_scale": 1.0,
  "min_font_size": 5.0,
  "line_spacing": 1.05,
  "dual_gap": 1.6,
  "lettering_font_regular": "",
  "lettering_font_bold": "",
  "lettering_font_family": "auto",
  "lettering_use_system_fonts": true,
  "lettering_tracking": 0.08,
  "numeric_guard": true,
  "numeric_log_limit": 5,
  "symbol_fallback": true,
  "table_cell_clamp": true,
  "table_row_clamp": true,
  "ocr_mode": "auto",
  "ocr_lang": "ch",
  "ocr_dpi": 300,
  "ocr_min_confidence": 0.5,
  "ocr_det_version": "v5",
  "ocr_use_cls": false,
  "ocr_cover_original": true,
  "export_pdf": true,
  "export_markdown": true,
  "page_range": "all",
  "theme": "light"
}
